{
  "expo": {
    "name": "The Chair",
    "slug": "the-chair",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thechair.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "The Chair uses the microphone to record voice messages for your loved one.",
        "NSPhotoLibraryUsageDescription": "The Chair lets you choose a photo of the day to send.",
        "NSCameraUsageDescription": "The Chair lets you take a photo of the day to send.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1D1D1D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.thechair.app",
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#1D1D1D",
      "output": "single",
      "name": "The Chair",
      "shortName": "The Chair",
      "themeColor": "#1D1D1D"
    },
    "scheme": "thechair",
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#1D1D1D"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "The Chair uses the microphone to record voice messages for your loved one."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The Chair lets you choose a photo of the day to send.",
          "cameraPermission": "The Chair lets you take a photo of the day to send."
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/the-chair"
    },
    "backgroundColor": "#1D1D1D"
  }
}
